# ==========================================================================
#  EcoTrace — Variables de entorno (MVP SvelteKit + Firebase)
#  Copiá este archivo a `.env` y completá con tus credenciales reales.
#  IMPORTANTE: `.env` está en .gitignore. NUNCA commitees credenciales.
# ==========================================================================

# --------------------------------------------------------------------------
#  Firebase Web SDK (CLIENTE) — SvelteKit expone solo las variables PUBLIC_*
#  Firebase Console > Configuración del proyecto > Tus apps > SDK config
# --------------------------------------------------------------------------
PUBLIC_FIREBASE_API_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
PUBLIC_FIREBASE_AUTH_DOMAIN="ecotrace-mvp.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="ecotrace-mvp"
PUBLIC_FIREBASE_STORAGE_BUCKET="ecotrace-mvp.appspot.com"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# --------------------------------------------------------------------------
#  Storage emulator (desarrollo) — MVP sin plan Blaze
#  "true": las subidas de archivos van al emulador local (firebase emulators).
# --------------------------------------------------------------------------
PUBLIC_USE_STORAGE_EMULATOR="false"

# --------------------------------------------------------------------------
#  Firebase emulator local completo (Auth + Firestore + Storage)
#  "true": el cliente y el servidor usan los emuladores locales.
#  Solo para desarrollo local, no habilites esto en producción.
# --------------------------------------------------------------------------
PUBLIC_USE_FIREBASE_EMULATORS="false"
USE_FIREBASE_EMULATORS="false"

# --------------------------------------------------------------------------
#  Firebase Admin SDK (SERVIDOR) — NUNCA se expone al navegador
#  Firebase Console > Configuración > Cuentas de servicio > Generar clave privada
#  La clave privada va en UNA sola línea con \n escapados (como en el JSON).
# --------------------------------------------------------------------------
FIREBASE_PROJECT_ID="ecotrace-mvp"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@ecotrace-mvp.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEF...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------------------
#  Sesión (cookie httpOnly firmada por firebase-admin)
# --------------------------------------------------------------------------
SESSION_COOKIE_NAME="__session"
SESSION_COOKIE_DAYS="5"

# --------------------------------------------------------------------------
#  Web3 / Blockchain — Frontend (Vite, expuesto al navegador)
#  VITE_PUBLIC_* se inyectan en el bundle del cliente vía import.meta.env.*
#  Nunca pongas claves privadas aquí.
# --------------------------------------------------------------------------

# EVM JSON-RPC endpoint (opcional — usa el RPC público de la cadena si se omite)
VITE_PUBLIC_RPC_URL="http://127.0.0.1:8545"

# Dirección del contrato EcoTraceRegistry desplegado (0x-prefixed)
VITE_PUBLIC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Chain ID como entero decimal:
#   31337   → Anvil local (default)
#   11155111 → Ethereum Sepolia
#   421614  → Arbitrum Sepolia
VITE_PUBLIC_CHAIN_ID="31337"

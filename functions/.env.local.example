# ==========================================================================
#  functions/.env.local — Variables locales para el emulador de Firebase.
#
#  Copiá este archivo a `functions/.env.local` y completá con tus valores.
#  Este archivo es leído AUTOMÁTICAMENTE por `firebase emulators:start`.
#
#  IMPORTANTE:
#  - `functions/.env.local` está en .gitignore. NUNCA commitees credenciales.
#  - En producción estas variables NO se usan: los secretos vienen de
#    Google Cloud Secret Manager (RELAYER_PRIVATE_KEY, WEB3_RPC_URL).
#  - En el emulador, si las variables de abajo están vacías, el sistema
#    usa la cuenta 0 de Anvil y http://127.0.0.1:8545 por defecto.
# ==========================================================================

# --------------------------------------------------------------------------
#  Secretos sensibles (solo para emulador local)
#  En producción estos valores se gestionan con:
#    firebase functions:secrets:set RELAYER_PRIVATE_KEY
#    firebase functions:secrets:set WEB3_RPC_URL
# --------------------------------------------------------------------------

# Clave privada del relayer (0x-prefixed). Por defecto: cuenta 0 de Anvil.
RELAYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# RPC del nodo EVM local. Por defecto: Anvil en localhost.
WEB3_RPC_URL="http://127.0.0.1:8545"

# --------------------------------------------------------------------------
#  Configuración no sensible (también usada en producción vía env vars)
# --------------------------------------------------------------------------

# Dirección del contrato EcoTraceRegistry desplegado.
CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Chain ID: 31337 = Anvil local, 11155111 = Sepolia, 421614 = Arbitrum Sepolia.
CHAIN_ID="31337"

# Umbral mínimo de ETH en la wallet del relayer antes de alertar. Default: 0.05.
RELAYER_MIN_BALANCE_ETH="0.05"
